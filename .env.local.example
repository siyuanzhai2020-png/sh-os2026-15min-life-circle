# 复制成 .env.local 后填入自己的值。.env.local 已被 .gitignore 忽略，绝不会进仓库。
#
# 申请入口：https://lbsyun.baidu.com/ → 控制台 → 应用管理 → 创建应用
#   · 服务端 AK：用于地点检索 / 地理编码 / 步行路径规划（必须开通"Web 服务 API"）
#   · 浏览器端 AK（白名单）：用于 JSAPI GL 底图，需把 http://127.0.0.1:8000 加进 Referer 白名单
# 详见 docs/baidu-ak.md

BAIDU_SERVER_AK=
BAIDU_WEB_AK=

# 可选：只有开启了"SN 校验"才需要填。填了会自动按官方规则签名。
BAIDU_SK=
